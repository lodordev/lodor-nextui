# Parity item #1, launch-card-v2 always-show shape: LOCAL=current (nothing newer) still hands
# to the wizard — the card shows every launch (2026-07-11 contract; Play is one press). The
# hook itself never draws — the old hook-drawn minui-list picker cannot come back through
# this path.
desc fetch hook: LOCAL=current -> full card handoff, no hook picker
invoke prehook
config paired
romarg Roms/Game Boy Advance (GBA)/✓ Zelda.gba
sdfile+ Roms/Game Boy Advance (GBA)/✓ Zelda.gba
engine 0|101\t2026-07-01 10:00\tBrick\t32KB\tCURRENT\n99\t2026-06-30 09:00\tFlip\t31KB\nLOCAL=current
wizard 0|LAUNCHCARD mode=summoned shown=1 action=play evicted=0
expect_exit 0
expect_trace_absent LIST[
expect_trace ENGINE --list-saves
expect_trace WIZARD --launch-card --summoned
expect_log local=current action=card
